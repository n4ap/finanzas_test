generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Identidad ─────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  locale       String   @default("es-ES")
  timezone     String   @default("Europe/Madrid")
  currency     String   @default("EUR")
  theme        String   @default("system") // light | dark | system
  city         String   @default("Madrid")
  preferences  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  calendars     Calendar[]
  emails        Email[]
  tasks         Task[]
  projects      Project[]
  articles      NewsArticle[]
  bankAccounts  BankAccount[]
  transactions  Transaction[]
  budgets       Budget[]
  portfolios    Portfolio[]
  workouts      Workout[]
  metrics       HealthMetric[]
  trips         Trip[]
  notifications Notification[]
  automations   Automation[]
  conversations AIConversation[]
  families      FamilyMember[]
  shopping      ShoppingItem[]
  healthGoals   HealthGoal[]
  proposals     AIProposal[]
  auditLogs     AuditLog[]
  layout        DashboardLayout?
  memberships   HouseholdMember[]
  coachAnswers  CoachAnswer[]
  goals         Goal[]
  reviews       Review[]
  decisions     Decision[]
}

/// Sesión con token opaco; en BD solo se guarda su hash SHA-256.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Cuenta conectada de un proveedor externo (Google, Microsoft, ...). Tokens SIEMPRE cifrados (AES-256-GCM).
model Account {
  id              String        @id @default(cuid())
  userId          String
  provider        String // google | microsoft | news | csv | openai | anthropic | ollama ...
  kind            String // email | calendar | news | finance | ai
  externalId      String?
  label           String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  scope           String?
  expiresAt       DateTime?
  status          String        @default("connected") // connected | error | revoked
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendars       Calendar[]
  articles        NewsArticle[]

  @@unique([userId, provider, kind, externalId])
}

model Household {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  members   HouseholdMember[]
  accounts  BankAccount[]
}

model HouseholdMember {
  householdId String
  userId      String
  role        String    @default("member") // owner | member
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
}

model DashboardLayout {
  userId    String   @id
  widgets   Json // [{id, visible, order, size}]
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────── Calendario ─────────────

model Calendar {
  id         String   @id @default(cuid())
  userId     String
  accountId  String?
  externalId String?
  name       String
  color      String   @default("#6366f1")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  events     Event[]
}

model Event {
  id          String   @id @default(cuid())
  calendarId  String
  externalId  String?
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  attendees   String[] @default([])
  important   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([calendarId, startsAt])
}

// ───────────── Email ─────────────

model Email {
  id         String    @id @default(cuid())
  userId     String
  externalId String?
  folder     String    @default("inbox") // inbox | sent | archive
  fromName   String
  fromEmail  String
  toEmails   String[]  @default([])
  subject    String
  body       String
  snippet    String
  receivedAt DateTime
  read       Boolean   @default(false)
  starred    Boolean   @default(false)
  important  Boolean   @default(false)
  needsReply Boolean   @default(false)
  replied    Boolean   @default(false)
  deadline   DateTime?
  category   String? // trabajo | finanzas | personal | newsletter | viajes ...
  summary    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, folder, receivedAt])
}

// ───────────── Tareas y proyectos ─────────────

model Project {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  status      String    @default("active") // planned | active | paused | done
  priority    Int       @default(2) // 1 alta, 2 media, 3 baja
  color       String    @default("#6366f1")
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id              String    @id @default(cuid())
  userId          String
  projectId       String?
  parentId        String?
  title           String
  description     String?
  priority        Int       @default(2) // 1 alta, 2 media, 3 baja
  status          String    @default("inbox") // inbox | next | in_progress | waiting | done
  dueDate         DateTime?
  estimateMinutes Int?
  tags            String[]  @default([])
  recurrence      String? // RRULE simplificada: daily | weekly | monthly
  remindAt        DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent          Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        Task[]    @relation("Subtasks")

  @@index([userId, status])
  @@index([userId, dueDate])
}

// ───────────── Noticias ─────────────

model NewsArticle {
  id          String   @id @default(cuid())
  userId      String
  accountId   String? // feed del que procede (al desconectarlo se borran sus artículos)
  externalId  String?
  category    String // ia | tecnologia | economia | finanzas | deportes | espana | mundo
  title       String
  source      String
  url         String
  imageUrl    String?
  summary     String
  aiSummary   String?
  importance  Int      @default(0) // 0-100
  publishedAt DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, publishedAt])
}

// ───────────── Finanzas ─────────────

model BankAccount {
  id             String        @id @default(cuid())
  ownerId        String
  householdId    String? // si está definido, cuenta compartida
  name           String
  kind           String        @default("checking") // checking | savings | cash | credit
  currency       String        @default("EUR")
  openingBalance Decimal       @default(0) @db.Decimal(14, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  household      Household?    @relation(fields: [householdId], references: [id], onDelete: SetNull)
  transactions   Transaction[]
}

model Transaction {
  id          String      @id @default(cuid())
  userId      String
  accountId   String
  date        DateTime
  amount      Decimal     @db.Decimal(14, 2) // negativo = gasto, positivo = ingreso
  category    String // vivienda | alimentacion | transporte | ocio | compras | viajes | suscripciones | otros | ingresos
  description String
  merchant    String?
  recurring   Boolean     @default(false)
  upcoming    Boolean     @default(false) // pago previsto
  source      String      @default("manual") // manual | csv | provider
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([accountId, date])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  monthly   Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model Portfolio {
  id          String              @id @default(cuid())
  userId      String
  name        String
  currency    String              @default("EUR")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  investments Investment[]
  snapshots   PortfolioSnapshot[]
}

model Investment {
  id            String     @id @default(cuid())
  portfolioId   String
  assetType     String // stock | etf | fund | crypto
  symbol        String
  name          String
  quantity      Decimal    @db.Decimal(20, 8)
  avgCost       Decimal    @db.Decimal(14, 4)
  currentPrice  Decimal    @db.Decimal(14, 4)
  dividendYield Decimal    @default(0) @db.Decimal(6, 3)
  isin          String? // opcional: ayuda a encontrar el precio de fondos y ETF
  quoteSymbol   String? // ticker de mercado resuelto a partir del ISIN (caché)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  portfolio     Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  dividends     Dividend[]
}

/// Dividendo cobrado de una posición.
model Dividend {
  id           String     @id @default(cuid())
  investmentId String
  date         DateTime
  amount       Decimal    @db.Decimal(14, 2)
  createdAt    DateTime   @default(now())
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId, date])
}

/// Valor de la cartera en una fecha (para la gráfica de evolución). Un registro por día.
model PortfolioSnapshot {
  id          String    @id @default(cuid())
  portfolioId String
  date        DateTime
  value       Decimal   @db.Decimal(16, 2)
  cost        Decimal   @db.Decimal(16, 2)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, date])
}

/// Auditoría de cambios en datos financieros.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  entity    String // Transaction | BankAccount | Budget | Investment
  entityId  String
  action    String // create | update | delete
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entity, entityId])
}

// ───────────── Salud ─────────────

model Workout {
  id        String   @id @default(cuid())
  userId    String
  kind      String // gym | padel | cardio | other
  title     String
  date      DateTime
  minutes   Int
  calories  Int?
  notes     String?
  planned   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model HealthMetric {
  id        String   @id @default(cuid())
  userId    String
  kind      String // weight | steps | sleep
  date      DateTime
  value     Float
  source    String   @default("manual") // manual | apple_health | google_fit | garmin | fitbit
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, date, source])
}

// ───────────── Viajes y familia ─────────────

model Trip {
  id          String          @id @default(cuid())
  userId      String
  name        String
  destination String
  startDate   DateTime
  endDate     DateTime
  budget      Decimal?        @db.Decimal(14, 2)
  notes       String?
  itinerary   Json            @default("[]") // heredado, sin uso (el itinerario vive en ItineraryItem)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings    Travel[]
  days        ItineraryItem[]
  packing     PackingItem[]
}

/// Reserva/segmento de un viaje (vuelo, hotel, ...).
model Travel {
  id        String    @id @default(cuid())
  tripId    String
  kind      String // flight | hotel | train | car | activity
  title     String
  reference String?
  startsAt  DateTime?
  endsAt    DateTime?
  cost      Decimal?  @db.Decimal(14, 2)
  details   String?
  createdAt DateTime  @default(now())
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id        String    @id @default(cuid())
  userId    String
  name      String
  relation  String
  birthday  DateTime?
  color     String    @default("#10b981")
  notes     String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShoppingItem {
  id        String   @id @default(cuid())
  userId    String
  label     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, done])
}

model HealthGoal {
  id     String @id @default(cuid())
  userId String
  kind   String // weight | steps | sleep | workouts (por semana)
  target Float
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

model ItineraryItem {
  id     String   @id @default(cuid())
  tripId String
  date   DateTime // día (12:00 UTC)
  time   String? // HH:MM opcional
  title  String
  notes  String?
  trip   Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, date])
}

model PackingItem {
  id     String  @id @default(cuid())
  tripId String
  label  String
  packed Boolean @default(false)
  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// ───────────── Notificaciones, automatizaciones, IA ─────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // email | event | task | payment | finance | automation | ai
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Automation {
  id                   String          @id @default(cuid())
  userId               String
  name                 String
  triggerType          String // task_overdue | budget_alert | birthday_soon | email_needs_reply | trip_soon | weekly
  triggerConfig        Json            @default("{}")
  actionType           String // notify | create_task | digest
  actionConfig         Json            @default("{}")
  requiresConfirmation Boolean         @default(true)
  enabled              Boolean         @default(true)
  lastRunAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs                 AutomationRun[]
}

/// Cada disparo de una automatización por entidad/periodo; la unicidad garantiza que no se repita (idempotencia).
model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  key          String
  createdAt    DateTime   @default(now())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, key])
}

/// Acción propuesta por el asistente o una automatización: NO se ejecuta hasta que el usuario la confirma.
model AIProposal {
  id             String    @id @default(cuid())
  userId         String
  conversationId String?
  tool           String
  args           Json
  summary        String
  status         String    @default("pending") // pending | confirmed | cancelled | failed
  result         String?
  source         String    @default("assistant") // assistant | automation
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  resolvedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String // user | assistant | tool
  content        String
  toolCalls      Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Tareas periódicas ya hechas (precios diarios, copias…): la clave única evita repetirlas el mismo día.
model JobRun {
  key       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────── Coach personal ─────────────

/// Respuesta a una pregunta de la entrevista del coach: forma el «mapa personal de vida».
model CoachAnswer {
  id        String   @id @default(cuid())
  userId    String
  key       String // id de la pregunta (src/lib/coach.ts)
  area      String
  answer    String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

/// Objetivo en 4 niveles: visión → anual → trimestral (90 días) → semanal.
model Goal {
  id         String    @id @default(cuid())
  userId     String
  parentId   String?
  level      String // vision | annual | quarterly | weekly
  area       String // salud | relaciones | finanzas | trabajo | crecimiento | ocio | personal
  title      String
  why        String?
  metric     String?
  baseline   String?
  target     String?
  progress   Int       @default(0) // 0-100
  dueDate    DateTime?
  nextAction String?
  obstacles  String?
  planB      String?
  status     String    @default("active") // active | done | dropped
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Goal?     @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Goal[]    @relation("GoalTree")

  @@index([userId, status])
}

/// Revisión diaria, semanal o mensual. `period` = día (AAAA-MM-DD), lunes de la semana o mes (AAAA-MM).
model Review {
  id        String   @id @default(cuid())
  userId    String
  kind      String // daily | weekly | monthly
  period    String
  answers   Json     @default("{}")
  scores    Json? // semanal: puntuación 0-10 por área
  energy    Int?
  mood      Int?
  stress    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, period])
}

/// Decisión importante estructurada: objetivo, opciones (ventajas, desventajas, riesgos, coste), impacto y próxima acción.
model Decision {
  id             String   @id @default(cuid())
  userId         String
  title          String
  objective      String?
  options        Json     @default("[]")
  impact         String?
  recommendation String?
  nextAction     String?
  status         String   @default("open") // open | decided
  chosen         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
